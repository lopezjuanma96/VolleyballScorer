# One branch and image; select local, onprem, cloud (bundled Caddy) or edge (shared Caddy
# from the vps-edge repo, for a VPS that hosts several apps).
DEPLOY_MODE=local
# scripts/stack.sh selects the matching Compose profile automatically.
APP_PORT=3000
APP_BIND=127.0.0.1
# Set to your public HTTPS origin for onprem/cloud/edge.
PUBLIC_URL=http://localhost:3000
# cloud only: host the bundled Caddy answers; must match PUBLIC_URL.
DOMAIN=voley.example.com
# edge only: external Docker network of the shared Caddy and this app's unique name on it.
# The shared Caddy proxies to EDGE_ALIAS:3000; never use "app", other stacks may share it.
# EDGE_NETWORK=edge
# EDGE_ALIAS=voley

PSQL_DATABASE=scorer
PSQL_USER=scorer
# Generate these locally with: bun scripts/setup.ts
PSQL_PASSWORD=
MANAGER_USER=manager
MANAGER_PASSWORD=
SESSION_SECRET=
# Google sign-in for organization and scorers (docs/hostinger.md#google). Leave both blank
# to allow only the manager. Redirect URI: <PUBLIC_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local testing only (refused unless DEPLOY_MODE=local): sign in as any active member by
# email from the login page, without Google. Never enable it on a reachable server.
DEV_LOGIN=false
# Contact shown on /privacy_policy for data requests (optional).
CONTACT_EMAIL=
# For a managed PostgreSQL, use DATABASE_URL instead of PSQL_* in the app.
# DATABASE_URL=postgresql://user:password@host:5432/scorer?sslmode=require
# COOKIE_SECURE defaults to true outside local mode.
# TRUST_PROXY_HOPS defaults to 0 locally and 1 behind the public edge proxy.
# Only trust forwarded addresses when the app cannot be reached directly.
# TRUST_PROXY_HOPS=1
# Caddy (bundled or shared)/ngrok use x-forwarded-for; Railway documents x-real-ip.
# CLIENT_IP_HEADER=x-real-ip

NGROK_AUTHTOKEN=
TOURNAMENT_NAME=Torneo de vóley
TOURNAMENT_SUBTITLE=Cada punto cuenta.
TOURNAMENT_ACCENT="#b9ed64"
TOURNAMENT_TIMEZONE=America/Argentina/Cordoba
# Courts offered when scheduling matches (1–20).
TOURNAMENT_COURTS=4
