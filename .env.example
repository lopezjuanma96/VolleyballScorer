# One branch and image; select local, onprem or cloud.
DEPLOY_MODE=local
# scripts/stack.sh selects the matching Compose profile automatically.
APP_PORT=3000
APP_BIND=127.0.0.1
# Set to your public HTTPS origin for onprem/cloud.
PUBLIC_URL=http://localhost:3000
DOMAIN=voley.example.com

PSQL_DATABASE=scorer
PSQL_USER=scorer
# Generate these locally with: bun scripts/setup.ts
PSQL_PASSWORD=
MANAGER_USER=manager
MANAGER_PASSWORD=
SESSION_SECRET=
# For a managed PostgreSQL, use DATABASE_URL instead of PSQL_* in the app.
# DATABASE_URL=postgresql://user:password@host:5432/scorer?sslmode=require
# COOKIE_SECURE defaults to true outside local mode.
# TRUST_PROXY_HOPS defaults to 0 locally and 1 behind the public edge proxy.
# Only trust forwarded addresses when the app cannot be reached directly.
# TRUST_PROXY_HOPS=1
# Caddy/ngrok use x-forwarded-for; Railway documents x-real-ip.
# CLIENT_IP_HEADER=x-real-ip

NGROK_AUTHTOKEN=
TOURNAMENT_NAME=Torneo de vóley
TOURNAMENT_SUBTITLE=Cada punto cuenta.
TOURNAMENT_ACCENT="#b9ed64"
TOURNAMENT_TIMEZONE=America/Argentina/Cordoba
